# Shared settings for docker compose. Copy to .env and change every value.
# Generate secrets with: openssl rand -hex 32

# PostgreSQL password used by the bundled database service.
# Use only URL-safe characters (letters, numbers, - and _) because the value
# is embedded in the API connection string.
POSTGRES_PASSWORD=change-me-postgres-password

# Long random secret used to sign access tokens (32+ characters).
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Shared API key between the web app and the API (16+ characters).
API_KEY=change-me-to-a-long-random-api-key

# Public URL of the web app. Used for CORS and as the browser entry point.
APP_URL=http://localhost:3000

# Keep registration closed after the first administrator is created.
ALLOW_PUBLIC_REGISTRATION=false
