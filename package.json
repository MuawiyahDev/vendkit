{
  "name": "vendkit",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @repo/database generate",
    "db:migrate": "pnpm --filter @repo/database migrate",
    "db:deploy": "pnpm --filter @repo/database deploy",
    "db:studio": "pnpm --filter @repo/database studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react-phone-number-input": "^3.4.18"
  }
}
