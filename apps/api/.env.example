# PostgreSQL connection string. Required.
# The API reads additional values from packages/database/.env when running
# locally; Docker Compose passes this variable directly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openorder?schema=public

# API secrets - copy this file to .env and fill in real values
# Use a long random value, for example: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# Required in production, for example: https://orders.example.com
CORS_ORIGINS=http://localhost:3000

# Comma-separated list of API keys accepted for machine-to-machine auth.
# Must match API_KEY in apps/web/.env. Generate with: openssl rand -hex 32
API_KEY=

# Public sign-up is closed after the first account by default. The first
# account always becomes the administrator. Set to true only if you want to
# let more people register themselves. Prefer creating accounts as an admin.
ALLOW_PUBLIC_REGISTRATION=false

# Directory where uploaded image files are stored (relative paths resolve from
# the API working directory). The directory is created automatically at startup
# and must be writable by the API process.
IMAGE_STORAGE_DIR=uploads/images

# Maximum accepted image upload size in bytes (default: 5242880 = 5 MB)
IMAGE_MAX_FILE_SIZE=5242880

# Directory where backup archives are written. Must be writable by the API
# process and should be included in the host's own volume/disk backups. It must
# not be inside IMAGE_STORAGE_DIR because restores swap the media directory.
BACKUP_STORAGE_DIR=uploads/backups

# Maximum accepted backup upload/archive size in bytes (default: 1 GB) and the
# maximum uncompressed archive size accepted during restore (default: 2 GB).
BACKUP_MAX_FILE_SIZE=1073741824
BACKUP_MAX_EXTRACTED_SIZE=2147483648

# Timeout for the consistent snapshot read and the atomic restore transaction
# in milliseconds (default: 600000 = 10 minutes).
BACKUP_RESTORE_TRANSACTION_TIMEOUT_MS=600000

# Create a safety backup of the current data before replacing it during a
# restore. Keep enabled unless the deployment cannot afford the extra work.
BACKUP_SAFETY_SNAPSHOT=true

# Optional version recorded in backup metadata. Defaults to 0.0.1.
APP_VERSION=
