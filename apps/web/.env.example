# Server-only configuration read by Next.js route handlers.
# Never expose these to the browser via NEXT_PUBLIC_*.
# The NestJS API uses a global `api` prefix, so include the trailing `/api`.
NEST_API_URL=http://localhost:4000/api

# API key sent as `x-api-key` to the NestJS API.
# Must match one of the keys configured in the API's API_KEY variable.
API_KEY=change-me
