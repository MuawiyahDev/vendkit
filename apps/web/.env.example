# Server-only configuration read by Next.js route handlers.
# Never expose these to the browser via NEXT_PUBLIC_*.
# The NestJS API uses a global `api` prefix, so include the trailing `/api`.
NEST_API_URL=http://localhost:4000/api

# API key sent as `x-api-key` to the NestJS API.
# Must match one of the keys configured in the API's API_KEY variable.
API_KEY=change-me

# Optional business details printed on order invoice PDFs. When a value is
# omitted, the invoice still renders with the business name "VendKit".
INVOICE_BUSINESS_NAME=VendKit
# Separate multiple address lines with a real newline or a literal `\n`.
INVOICE_BUSINESS_ADDRESS=
INVOICE_BUSINESS_PHONE=
INVOICE_BUSINESS_EMAIL=
INVOICE_BUSINESS_WEBSITE=
INVOICE_BUSINESS_TAX_ID=
INVOICE_PAYMENT_TERMS=
INVOICE_FOOTER_NOTE=Thank you for your business.
