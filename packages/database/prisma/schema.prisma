generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_FINANCIAL_SERVICE
  CARD
  OTHER
}

enum OrderPaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CurrencyPosition {
  BEFORE
  AFTER
}

enum CurrencyDisplayFormat {
  SYMBOL
  CODE
  SYMBOL_AND_CODE
}

enum TaxPricingMode {
  INCLUSIVE
  EXCLUSIVE
}

enum InvoiceDefaultStatus {
  DRAFT
  ISSUED
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum BackupKind {
  MANUAL
  PRE_RESTORE
}

enum RestoreStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum StockMovementType {
  INITIAL
  MANUAL_INCREASE
  MANUAL_DECREASE
  SET
  ORDER_PLACED
  ORDER_UPDATED
  ORDER_CANCELLED
  ORDER_DELETED
  RETURN
  DAMAGE
}

enum StockMovementReason {
  INITIAL_STOCK
  RESTOCK
  PURCHASE
  CUSTOMER_RETURN
  DAMAGED
  LOST
  CORRECTION
  SALE
  ORDER_CANCELLED
  ORDER_EDITED
  ORDER_DELETED
  OTHER
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String?
  password     String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  backups       Backup[]
  restoreJobs   RestoreJob[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive, createdAt])
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive, createdAt])
}

model Image {
  id           String         @id @default(uuid())
  originalName String
  storageKey   String         @unique
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  altText      String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  products            ProductImage[]
  businessProfileLogo BusinessProfileSettings? @relation("BusinessProfileLogo")
  invoiceLogo         InvoiceSettings?         @relation("InvoiceLogo")

  @@index([createdAt])
}

model Product {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  description       String?
  shortDescription  String?
  sku               String?        @unique
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId           String?
  brand             Brand?         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit             String?
  sellingPrice      Decimal        @db.Decimal(12, 2)
  compareAtPrice    Decimal?       @db.Decimal(12, 2)
  stockQuantity     Int            @default(0)
  lowStockThreshold Int?
  trackInventory    Boolean        @default(true)
  weight            Decimal?       @db.Decimal(12, 3)
  length            Decimal?       @db.Decimal(12, 2)
  width             Decimal?       @db.Decimal(12, 2)
  height            Decimal?       @db.Decimal(12, 2)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  images            ProductImage[]
  orderItems        OrderItem[]
  stockMovements    StockMovement[]

  @@index([categoryId, createdAt])
  @@index([brandId, createdAt])
  @@index([isActive, createdAt])
  @@index([stockQuantity])
  @@index([trackInventory, stockQuantity])
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  phone      String
  email      String?
  address    String?
  city       String?
  postalCode String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]

  @@index([phone])
  @@index([name])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageId   String
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Restrict)
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, imageId])
  @@index([productId, sortOrder])
}

model Order {
  id                 String        @id @default(uuid())
  orderNumber        String        @unique
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             OrderStatus   @default(PENDING)
  paymentStatus      PaymentStatus @default(UNPAID)
  currency           String        @default("BDT") @db.VarChar(3)
  subtotal           Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  shippingFee        Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  amountPaid         Decimal       @default(0) @db.Decimal(12, 2)
  stockDeducted      Boolean       @default(false)
  shippingName       String?
  shippingPhone      String?
  shippingAddress    String?
  shippingCity       String?
  shippingPostalCode String?
  customerNote       String?
  internalNote       String?
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  items              OrderItem[]
  payments           OrderPayment[]
  stockMovements     StockMovement[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  sku         String?
  unitPrice        Decimal  @db.Decimal(12, 2)
  quantity         Int
  lineTotal        Decimal  @db.Decimal(12, 2)
  trackedInventory Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

/// Immutable audit trail of every stock change. Product, order and user
/// details are snapshotted so history survives later edits or deletions.
model StockMovement {
  id              String              @id @default(uuid())
  productId       String?
  product         Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  sku             String?
  type            StockMovementType
  reason          StockMovementReason
  previousQuantity Int
  quantityChange  Int
  newQuantity     Int
  note            String?
  orderId         String?
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderNumber     String?
  userId          String?
  userName        String?
  idempotencyKey  String?             @unique
  createdAt       DateTime            @default(now())

  @@index([productId, createdAt])
  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model OrderPayment {
  id        String             @id @default(uuid())
  orderId   String
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount    Decimal            @db.Decimal(12, 2)
  method    PaymentMethod
  status    OrderPaymentStatus @default(COMPLETED)
  reference String?
  note      String?
  paidAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([orderId, reference])
  @@index([orderId, status])
}

/// Singleton business profile used by invoices, documents and notifications.
model BusinessProfileSettings {
  id                      String   @id @default("default") @db.VarChar(20)
  businessName            String   @default("VendKit") @db.VarChar(200)
  legalName               String?  @db.VarChar(200)
  logoImageId             String?  @unique
  logo                    Image?   @relation("BusinessProfileLogo", fields: [logoImageId], references: [id], onDelete: SetNull)
  email                   String?  @db.VarChar(254)
  phone                   String?  @db.VarChar(30)
  alternativePhone        String?  @db.VarChar(30)
  website                 String?  @db.VarChar(500)
  description             String?  @db.VarChar(2000)
  registrationNumber      String?  @db.VarChar(100)
  taxIdentificationNumber String?  @db.VarChar(100)
  addressLine1            String?  @db.VarChar(500)
  addressLine2            String?  @db.VarChar(500)
  city                    String?  @db.VarChar(100)
  state                   String?  @db.VarChar(100)
  postalCode              String?  @db.VarChar(20)
  country                 String?  @db.VarChar(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// Singleton invoice presentation, numbering and behaviour configuration.
model InvoiceSettings {
  id                      String                @id @default("default") @db.VarChar(20)
  useBusinessProfile      Boolean               @default(true)
  displayName             String?               @db.VarChar(200)
  logoImageId             String?               @unique
  logo                    Image?                @relation("InvoiceLogo", fields: [logoImageId], references: [id], onDelete: SetNull)
  email                   String?               @db.VarChar(254)
  phone                   String?               @db.VarChar(30)
  addressLine1            String?               @db.VarChar(500)
  addressLine2            String?               @db.VarChar(500)
  city                    String?               @db.VarChar(100)
  state                   String?               @db.VarChar(100)
  postalCode              String?               @db.VarChar(20)
  country                 String?               @db.VarChar(100)
  taxRegistrationNumber   String?               @db.VarChar(100)
  additionalInfo          String?               @db.VarChar(2000)
  numberPrefix            String                @default("INV") @db.VarChar(20)
  numberFormat            String                @default("{prefix}-{year}-{sequence}") @db.VarChar(100)
  yearBasedNumbering      Boolean               @default(true)
  automaticNumbering      Boolean               @default(true)
  startingSequence        Int                   @default(1)
  duePeriodDays           Int                   @default(30)
  paymentTerms            String?               @db.VarChar(1000)
  notes                   String?               @db.VarChar(2000)
  footerText              String?               @db.VarChar(1000)
  currencyDisplayFormat   CurrencyDisplayFormat @default(SYMBOL)
  showSku                 Boolean               @default(true)
  showTaxBreakdown        Boolean               @default(true)
  showDiscountBreakdown   Boolean               @default(true)
  defaultStatus           InvoiceDefaultStatus  @default(DRAFT)
  allowEditingAfterIssue  Boolean               @default(false)
  allowCancellation       Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

/// Singleton currency, country, timezone and formatting defaults.
model RegionalSettings {
  id                String          @id @default("default") @db.VarChar(20)
  currency          String          @default("BDT") @db.VarChar(3)
  currencySymbol    String          @default("৳") @db.VarChar(8)
  currencyPosition  CurrencyPosition @default(BEFORE)
  decimalPrecision  Int             @default(2)
  thousandSeparator String          @default(",") @db.VarChar(3)
  decimalSeparator  String          @default(".") @db.VarChar(3)
  defaultCountry    String          @default("BD") @db.VarChar(2)
  timezone          String          @default("Asia/Dhaka") @db.VarChar(100)
  dateFormat        String          @default("DD/MM/YYYY") @db.VarChar(20)
  timeFormat        String          @default("HH:mm") @db.VarChar(20)
  language          String          @default("en") @db.VarChar(10)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

/// Singleton tax defaults. Historical orders and invoices keep their own values.
model TaxSettings {
  id                      String         @id @default("default") @db.VarChar(20)
  enabled                 Boolean        @default(false)
  defaultName             String         @default("VAT") @db.VarChar(100)
  defaultRate             Decimal        @default(0) @db.Decimal(5, 2)
  taxIdentificationNumber String?        @db.VarChar(100)
  pricingMode             TaxPricingMode @default(EXCLUSIVE)
  showBreakdownOnInvoice  Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

/// Singleton order creation defaults and editing rules.
model OrderSettings {
  id                         String      @id @default("default") @db.VarChar(20)
  orderNumberPrefix          String      @default("ORD") @db.VarChar(20)
  automaticNumbering         Boolean     @default(true)
  defaultStatus              OrderStatus @default(PENDING)
  defaultNotes               String?     @db.VarChar(2000)
  allowEditing               Boolean     @default(true)
  requireCustomerInformation Boolean     @default(false)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
}

/// Singleton payment method availability and bank transfer details.
model PaymentSettings {
  id                  String          @id @default("default") @db.VarChar(20)
  enabledMethods      PaymentMethod[] @default([CASH, BANK_TRANSFER, MOBILE_FINANCIAL_SERVICE, CARD, OTHER])
  defaultMethod       PaymentMethod   @default(CASH)
  bankAccountName     String?         @db.VarChar(200)
  bankName            String?         @db.VarChar(200)
  accountNumber       String?         @db.VarChar(100)
  branchName          String?         @db.VarChar(200)
  routingNumber       String?         @db.VarChar(100)
  paymentInstructions String?         @db.VarChar(2000)
  defaultPaymentTerms String?         @db.VarChar(1000)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

/// Singleton shipping defaults. Delivery lifecycle remains in the orders module.
model ShippingSettings {
  id                  String   @id @default("default") @db.VarChar(20)
  enabled             Boolean  @default(true)
  defaultCharge       Decimal  @default(0) @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  deliveryInstructions String? @db.VarChar(2000)
  defaultDeliveryMethod String? @db.VarChar(100)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Singleton notification preferences. Delivery integrations live elsewhere.
model NotificationSettings {
  id                       String   @id @default("default") @db.VarChar(20)
  businessNotificationEmail String? @db.VarChar(254)
  orderConfirmationEnabled Boolean  @default(false)
  paymentEnabled           Boolean  @default(false)
  invoiceEnabled           Boolean  @default(false)
  senderName               String   @default("VendKit") @db.VarChar(200)
  replyToEmail             String?  @db.VarChar(254)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Atomic counters used to allocate unique, gap-tolerant document numbers.
model DocumentSequence {
  id        String   @id @default(uuid())
  key       String   @db.VarChar(50)
  year      Int
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, year])
  @@index([key])
}

/// A downloadable archive created by the backup module. Backup metadata is
/// intentionally excluded from the archive payload so history survives a
/// restore.
model Backup {
  id            String       @id @default(uuid())
  kind          BackupKind   @default(MANUAL)
  fileName      String
  storageKey    String       @unique
  sizeBytes     BigInt       @default(0)
  status        BackupStatus @default(IN_PROGRESS)
  progress      Int          @default(0)
  formatVersion Int
  appVersion    String       @db.VarChar(50)
  dataCounts    Json?
  errorMessage  String?
  createdById   String?
  createdBy     User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([createdAt])
  @@index([status])
}

/// Tracks an asynchronous restore so the dashboard can show progress and a
/// durable failure reason even if the connection drops.
model RestoreJob {
  id             String        @id @default(uuid())
  status         RestoreStatus @default(IN_PROGRESS)
  progress       Int           @default(0)
  sourceFileName String
  sourceBackupId String?
  formatVersion  Int?
  appVersion     String?       @db.VarChar(50)
  sizeBytes      BigInt?
  dataCounts     Json?
  errorMessage   String?
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  @@index([createdAt])
  @@index([status])
}
